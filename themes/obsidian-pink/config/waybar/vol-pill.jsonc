{
    "layer": "overlay",
    "exclusive": false,
    "passthrough": false,
    "position": "bottom",
    "margin-bottom": 45,
    "width": 140,
    "modules-center": ["custom/volume"],
    "custom/volume": {
        "exec": "$HOME/.config/waybar/scripts/get-volume.sh",
        "interval": "once",
        "on-click": "$HOME/.config/waybar/scripts/volume-osd.sh mute",
        "on-scroll-up": "$HOME/.config/waybar/scripts/volume-osd.sh raise",
        "on-scroll-down": "$HOME/.config/waybar/scripts/volume-osd.sh lower"
    }
}
