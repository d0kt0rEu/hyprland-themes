{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "38;2;255;42;133",
      "2": "38;2;157;78;221"
    },
    "padding": {
      "top": 1,
      "left": 0,
      "right": 1
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;157;78;221m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢  PC",
      "keyColor": "38;2;255;42;133"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 ",
      "keyColor": "38;2;255;42;133"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍹 ",
      "keyColor": "38;2;255;42;133"
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 ",
      "keyColor": "38;2;255;42;133"
    },
    {
      "type": "disk",
      "key": "└ └󰋊 ",
      "keyColor": "38;2;255;42;133"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;157;78;221m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;157;78;221m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "38;2;189;147;249"
    },
    {
      "type": "kernel",
      "key": "│ ├󰌽 ",
      "keyColor": "38;2;189;147;249"
    },
    {
      "type": "bios",
      "key": "│ ├󰖡 ",
      "keyColor": "38;2;189;147;249"
    },
    {
      "type": "packages",
      "key": "│ ├󰏗 ",
      "keyColor": "38;2;189;147;249"
    },
    {
      "type": "shell",
      "key": "└ └󰞷 ",
      "keyColor": "38;2;189;147;249"
    },
    "break",
    {
      "type": "de",
      "key": "󰧨  DE",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "lm",
      "key": "│ ├󰍁 ",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "wm",
      "key": "│ ├󱂬 ",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉦 ",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "terminal",
      "key": "└ └󰆍 ",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;157;78;221m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;255;42;133m┌─────────────────Uptime / Age / DT──────────────────┐"
    },
    {
      "type": "command",
      "key": "  ›  OS Age  ",
      "keyColor": "38;2;255;42;133",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  ›  Uptime  ",
      "keyColor": "38;2;255;42;133"
    },
    {
      "type": "datetime",
      "key": "  ›  DateTime  ",
      "keyColor": "38;2;255;42;133"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;255;42;133m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
