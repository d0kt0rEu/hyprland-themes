/**
 * Obsidian Pink Cyberpunk Rofi Theme
 * Keybindings Cheatsheet (Omarchy Style)
 **/

configuration {
    show-icons:                 false;
    click-to-exit:              true;
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    font:                       "JetBrainsMono Nerd Font 11";
}

@import "~/.config/rofi/colors/mocha.rasi"

* {
    border-colour:               #bd93f9;
    handle-colour:               #ff2a85;
    background-colour:           #0f0c16fa;
    foreground-colour:           #f1eef8;
    alternate-background:        #1a1528;
    normal-background:           transparent;
    normal-foreground:           #f1eef8;
    urgent-background:           #ff5555;
    urgent-foreground:           #ffffff;
    active-background:           #bd93f9;
    active-foreground:           #0f0c16;
    selected-normal-background:  #ff2a85;
    selected-normal-foreground:  #ffffff;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       920px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               16px;
    border-color:                #bd93f9;
    background-color:            #0f0c16fa;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     24px;
    border:                      0px solid;
    border-color:                transparent;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px 0px 8px 0px;
    padding:                     12px 18px;
    border:                      1px solid;
    border-radius:               12px;
    border-color:                #3a2d54;
    background-color:            #1a1528;
    text-color:                  #f1eef8;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  #ff79c6;
    font:                        "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  #ffffff;
    cursor:                      text;
    placeholder:                 "Search shortcuts (e.g. float, window, transparency, workspace)...";
    placeholder-color:           #705f82;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       13;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     4px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    background-color:            transparent;
    text-color:                  #f1eef8;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     8px 14px;
    border:                      0px solid;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  #f1eef8;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  #f1eef8;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  #f1eef8;
}

element normal.active {
    background-color:            #281b3d;
    text-color:                  #bd93f9;
}

element alternate.active {
    background-color:            #281b3d;
    text-color:                  #bd93f9;
}

element selected.normal {
    background-color:            #ff2a85;
    text-color:                  #ffffff;
}

element selected.active {
    background-color:            #bd93f9;
    text-color:                  #0f0c16;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
