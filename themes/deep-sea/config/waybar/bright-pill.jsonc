{
    "layer": "overlay",
    "exclusive": false,
    "passthrough": false,
    "position": "bottom",
    "margin-bottom": 45,
    "width": 140,
    "modules-center": ["custom/brightness"],
    "custom/brightness": {
        "exec": "/home/d0kt0r/.config/waybar/scripts/get-brightness.sh",
        "interval": "once",
        "on-scroll-up": "/home/d0kt0r/.config/waybar/scripts/brightness-osd.sh up",
        "on-scroll-down": "/home/d0kt0r/.config/waybar/scripts/brightness-osd.sh down"
    }
}
